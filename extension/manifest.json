{
  "manifest_version": 3,
  "name": "Lumen",
  "version": "0.3.0",
  "description": "Your own AI chat sidebar: pick the model, use your API key or your existing CLI login.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "permissions": [
    "sidePanel",
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "nativeMessaging",
    "contextMenus",
    "downloads",
    "declarativeNetRequestWithHostAccess",
    "management",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Lumen",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "description": "Open Lumen"
    }
  },
  "omnibox": {
    "keyword": "ai"
  }
}
