{
  "manifest_version": 3,
  "name": "BYO Sidebar",
  "version": "0.1.0",
  "description": "Your own AI chat sidebar: pick the model, use your API key or your existing CLI login.",
  "key": "",
  "permissions": ["sidePanel", "tabs", "scripting", "storage", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open BYO Sidebar" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "Command+Shift+E" }
    }
  }
}
